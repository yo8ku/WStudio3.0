{
  "$schema": "https://wstudio.dev/schemas/plugin-manifest.v1.json",
  "id": "com.example.word-count",
  "name": "Word Count",
  "version": "1.0.0",
  "description": "A minimal command-only WStudio plugin.",
  "author": {
    "name": "WStudio Example Team"
  },
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "apiVersion": "1.0",
  "main": "main.js",
  "activationEvents": [
    "onCommand:com.example.word-count.show"
  ],
  "permissions": [],
