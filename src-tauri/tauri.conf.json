{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WStudio",
  "version": "0.1.0",
  "identifier": "com.wstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run build:core-plugins && npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WStudio",
        "decorations": false,
        "backgroundColor": "#22272e",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["wstudio"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../plugin/core-plugins/": "plugin/core-plugins/"
    }
  }
}
